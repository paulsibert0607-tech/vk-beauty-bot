# Скопируйте этот файл в .env и заполните своими значениями.
# .env НЕ публикуется — он содержит токены и остаётся только у вас.

# Токен сообщества ВКонтакте (доступ: сообщения бота)
VK_TOKEN=

# ID сообщества ВКонтакте (число)
VK_GROUP_ID=

# ИИ-агент: ключ к API ProxyAPI
PROXY_API_KEY=
PROXY_API_BASE=https://api.proxyapi.ru/openai/v1
PROXY_MODEL=gpt-4o-mini

# Google-таблица для журнала записей (URL шаблона)
GOOGLE_SHEET_URL=

# Ваш ID ВКонтакте (число) — для уведомлений о записи
ADMIN_ID=